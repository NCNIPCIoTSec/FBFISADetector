{
    "INSTRUCTIONS":{
        "c.addi16sp-reduce": {
            "endian": "be",
            "regex": [
                "\\x71[\\x01\\x21\\x31\\x41\\x51\\x61\\x71\\x05-\\x0d\\x15-\\x1d\\x25-\\x2d\\x35-\\x3d\\x45-\\x4d\\x55-\\x5d\\x65-\\x6d\\x75-\\x7d]"
            ],
            "format": [
                "\\x71\\x01"
            ],
            "mask": [
                "\\xff\\x83"
            ],
            "descriptions": [
                "c.addi16sp - sp=add(sp, -0x??) - Stack Pointer reduce"
            ]
        },
        "ret": {
            "endian": "be",
            "regex": [
                "\\x80\\x82"
            ],
            "format": [
                "\\x80\\x82"
            ],
            "mask": [
                "\\xff\\xff"
            ],
            "descriptions": [
                "RET - ret - return ra"
            ]
        },
        "c.li": {
            "endian": "be",
            "regex": [
                "[\\x40-\\x5f][\\x01\\x05-\\x0d\\x11\\x15-\\x1d\\x21\\x25-\\x2d\\x31\\x35-\\x3d\\x41\\x45-\\x4d\\x51\\x55-\\x5d\\x61\\x65-\\x6d\\x71\\x75-\\x7d\\x81\\x85-\\x8d\\x91\\x95-\\x9d\\xa1\\xa5-\\xad\\xb1\\xb5-\\xbd\\xc1\\xc5-\\xcd\\xd1\\xd5-\\xdd\\xe1\\xe5-\\xed\\xf1\\xf5-\\xfd]"
            ],
            "format": [
                "\\x40\\x01"
            ],
            "mask": [
                "\\xe0\\x03"
            ],
            "descriptions": [
                "c.li - c.li imm[5] dest≠0 imm[4:0] C1 - C.LI loads the sign-extended 6-bit immediate, imm, into register rd. C.LI expands into addi rd, x0, imm[5:0]. C.LI is only valid when rd̸=x0; the code points with rd=x0 encode HINTs."
            ]
        },
        "c.sdsp":{
            "endian": "be",
            "regex": [
                "[\\xe0-\\xff][\\x02\\x06-\\x0e\\x12\\x16-\\x1e\\x22\\x26-\\x2e\\x32\\x36-\\x3e\\x42\\x46-\\x4e\\x52\\x56-\\x5e\\x62\\x66-\\x6e\\x72\\x76-\\x7e\\x82\\x86-\\x8e\\x92\\x96-\\x9e\\xa2\\xa6-\\xae\\xb2\\xb6-\\xbe\\xc2\\xc6-\\xce\\xd2\\xd6-\\xde\\xe2\\xe6-\\xee\\xf2\\xf6-\\xfe]"
            ],
            "format": [
                "\\xe0\\x02"
            ],
            "mask": [
                "\\xe0\\x03"
            ],
            "descriptions": [
                "c.sdsp - c.sdsp offset[5:3|8:6] src C2 - C.SDSP is an RV64C/RV128C-only instruction that stores a 64-bit value in register rs2 to memory. It computes an effective address by adding the zero-extended offset, scaled by 8, to the stack pointer, x2. It expands to sd rs2, offset[8:3](x2).."
            ]
        },
        "c.ldsp":{
            "endian": "be",
            "regex": [
                "[\\x60-\\x7f][\\x02\\x06-\\x0e\\x12\\x16-\\x1e\\x22\\x26-\\x2e\\x32\\x36-\\x3e\\x42\\x46-\\x4e\\x52\\x56-\\x5e\\x62\\x66-\\x6e\\x72\\x76-\\x7e\\x82\\x86-\\x8e\\x92\\x96-\\x9e\\xa2\\xa6-\\xae\\xb2\\xb6-\\xbe\\xc2\\xc6-\\xce\\xd2\\xd6-\\xde\\xe2\\xe6-\\xee\\xf2\\xf6-\\xfe]"
            ],
            "format": [
                "\\x60\\x02"
            ],
            "mask": [
                "\\xe0\\x03"
            ],
            "descriptions": [
                "c.ldsp - c.ldsp offset[5] dest≠0 offset[4:3|8:6] C2 - C.LDSP is an RV64C/RV128C-only instruction that loads a 64-bit value from memory into register rd. It computes its effective address by adding the zero-extended offset, scaled by 8, to the stack pointer, x2. It expands to ld rd, offset[8:3](x2). C.LDSP is only valid when rd̸=x0; the code points with rd=x0 are reserved.."
            ]
        }
    },
    "PAIRS": {
        "BLOCK_PAIRS": [
            {   
                "ins":["c.addi16sp-reduce", "ret"],
                "type": "FUNC-BOUNDARY",
                "features":{}
            }
        ],
        "INNER_BLOCK_PAIRS": [
            {
                "ins": ["c.sdsp", "c.ldsp"],
                "type": "ARGS_SAVE",
                "features": {
                    "register": [
                        "c.sdsp",
                        "c.ldsp",
                        [
                            ["\\x1f\\x80"],
                            ["\\x10\\x7d"]
                        ]
                    ]
                }
            }
        ]
    },
    "OTHERS": {
        "HighUsage": ["c.mv", "c.ld", "c.li"],
        "MemoryArgs":{
            "address_length": 8,
            "reverse_unit_size": 8,
            "min_instr_length": 2,
            "max_instr_length": 8, 
            "alignment_size": 2
        },
        "registers": {
            "special": {"r0": "zero", "r1": "ra", "r2": "sp", "r3": "gp", "r4": "tp", "r8": "fp"},
            "general": ["t0", "t1", "t2", "t3", "t4", "t5", "t6", "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11"],
            "calling-convention": {
                "argument-passing": ["a2", "a3", "a4", "a5", "a6", "a7"],
                "return-values": ["a0", "a1"]
            }
        },
        "SupportedEndian": "LE"
    }
}